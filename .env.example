# Schwab API
SCHWAB_CLIENT_ID=your_client_id_here
SCHWAB_CLIENT_SECRET=your_client_secret_here
SCHWAB_REDIRECT_URI=https://127.0.0.1

# Telegram
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Trading strategy
TARGET_ETFS=SCHD,JEPI          # comma-separated ETFs to buy
CASH_THRESHOLD=1000             # buy ETF when cash balance exceeds this amount
ETF_BUY_AMOUNT=500              # how much to spend per ETF buy
CHECK_INTERVAL_MINUTES=30       # how often the bot checks your account
