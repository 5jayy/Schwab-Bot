# Schwab API
SCHWAB_CLIENT_ID=your_client_id_here
SCHWAB_CLIENT_SECRET=your_client_secret_here
SCHWAB_REDIRECT_URI=https://127.0.0.1

# Telegram
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Stocks to trade (EMA/RSI signals)
TRADE_STOCKS=AAPL,AMZN,MSFT,GOOGL,NVDA

# ETF sweep
TARGET_ETFS=SCHD,JEPI
CASH_THRESHOLD=1000
ETF_BUY_AMOUNT=500

# Risk controls
MAX_STOCK_SPEND=1000        # max dollars per stock buy
CHECK_INTERVAL_MINUTES=30   # how often bot runs
