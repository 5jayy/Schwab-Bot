# Schwab API
SCHWAB_CLIENT_ID=your_client_id_here
SCHWAB_CLIENT_SECRET=your_client_secret_here
SCHWAB_REDIRECT_URI=https://127.0.0.1

# Telegram
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Profit split — 60/30/10
ETF_THRESHOLD=1000     # trigger split when profit hits $1000
ETF_PCT=0.60           # 60% goes to ETFs
CASH_PCT=0.30          # 30% goes to your cash (withdraw anytime)
BOT_PCT=0.10           # 10% added back to bot trading capital

# Bot settings
CHECK_INTERVAL_MINUTES=30
